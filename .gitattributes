# 统一换行符为 LF。
#
# 为什么需要这个文件：
#   工程是在 Windows 上编辑的，但云端构建跑在 Linux 上。
#   如果哪天在 Windows 上编辑后把 CRLF 提交进去，构建脚本和
#   配置文件在 Linux 上会出很难定位的问题。这里直接把规则写死。

* text=auto eol=lf

# 二进制文件必须排除在换行符转换之外，否则文件会被损坏
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.glb     binary
*.gltf    binary
*.ttf     binary
*.otf     binary
*.keystore binary
*.jks     binary
*.apk     binary
*.aab     binary
*.exe     binary
*.pck     binary

# 明确按 LF 处理的文本文件
*.gd     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.cfg    text eol=lf
*.godot  text eol=lf
*.svg    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
