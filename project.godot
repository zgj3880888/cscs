; Engine configuration file.
; Godot 4.7 工程配置 —— 手机第一人称射击（FPS）模板
;
; 说明：
;   输入映射（按键/鼠标/手柄动作）不写在本文件里，而是由 scripts/game_config.gd
;   在运行时通过 InputMap 注册。这样做的原因是 project.godot 里的输入事件序列化
;   格式会随引擎版本变化，运行时注册更稳、也更好读。

config_version=5

[application]

config/name="MobileFPS"
config/description="一个用 Godot 4.7 写的手机 3D 第一人称射击模板：触屏摇杆、射线射击、追踪敌人、波次刷新。"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.08, 0.11, 1)
boot_splash/show_image=false

[autoload]

GameConfig="*res://scripts/game_config.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 安卓导出强制要求：至少启用一种移动端 VRAM 纹理压缩格式，否则导出时报
; "ETC2/ASTC texture compression is required for Android export" 并直接失败。
; 不写这一行时，Godot 会回退去问宿主系统偏好哪种格式；在 Linux 构建机上返回的是
; 桌面格式（S3TC/BPTC），于是校验不通过 —— 本地在 Windows 上跑反而看不出来。
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
